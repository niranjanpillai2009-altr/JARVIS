<?xml version="1.0" encoding="utf-8"?>
<!--
  Simplified Robotiq 2F-85 inspired gripper for PyBullet.
  Two symmetric fingers driven by mirrored revolute joints.
  The "gripper_base_link" attaches to the robot's end-effector.
-->
<robot name="robotiq_2f85_simplified">

  <!-- ========== BASE (mounts to end-effector) ========== -->
  <link name="gripper_base_link">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.04 0.04"/>
      </geometry>
      <material name="gripper_dark">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.04 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- ========== LEFT FINGER ========== -->
  <link name="left_finger_link">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.015 0.06"/>
      </geometry>
      <material name="gripper_finger">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.015 0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_left_finger_joint" type="revolute">
    <origin xyz="0.02 0 0.04" rpy="0 0 0"/>
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.2" effort="20" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <!-- ========== RIGHT FINGER ========== -->
  <link name="right_finger_link">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.015 0.06"/>
      </geometry>
      <material name="gripper_finger">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.015 0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_right_finger_joint" type="revolute">
    <origin xyz="-0.02 0 0.04" rpy="0 0 0"/>
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="0" effort="20" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <!-- ========== LEFT FINGERTIP ========== -->
  <link name="left_fingertip_link">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="-0.005 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.015 0.022"/>
      </geometry>
      <material name="gripper_tip">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.005 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.015 0.022"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_fingertip_joint" type="fixed">
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <parent link="left_finger_link"/>
    <child link="left_fingertip_link"/>
  </joint>

  <!-- ========== RIGHT FINGERTIP ========== -->
  <link name="right_fingertip_link">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0.005 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.015 0.022"/>
      </geometry>
      <material name="gripper_tip">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.005 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.015 0.022"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_fingertip_joint" type="fixed">
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <parent link="right_finger_link"/>
    <child link="right_fingertip_link"/>
  </joint>

</robot>
